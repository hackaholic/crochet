{
  "name": "sulocraft",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.18",
      "nanoid@3": "3.3.18",
      "source-map-js": "^1.2.2",
      "undici@8": "^8.12.2"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-frontend.mjs",
    "build:dev": "node scripts/build-frontend.mjs preprod",
    "build:production": "node scripts/build-frontend.mjs production",
    "test": "node --test scripts/frontend-build-mode.node-test.mjs scripts/prerender.node-test.mjs scripts/seo-resources.node-test.mjs scripts/url-policy.node-test.mjs scripts/performance/budgets.node-test.mjs scripts/media/variants.node-test.mjs && vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "media:variants": "node scripts/media/generate-variants.mjs",
    "perf:budget": "node scripts/performance/budgets.mjs",
    "format": "oxfmt"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.2.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
