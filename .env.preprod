# Public development storefront built from the dev branch.
# This file is intentionally committed. VITE_ values are embedded in the
# browser bundle and must never contain credentials or other secrets.
VITE_LAUNCH_MODE=full
VITE_API_BASE_URL=https://api-dev.sulocraft.com/api/v1

# Public SEO build policy (no secrets). Keep launch/preprod out of indexing.
SEO_INDEXING_ENABLED=false
SEO_PUBLIC_ORIGIN=https://dev.sulocraft.com
