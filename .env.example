# Local Docker development
# Same-origin media works with localhost and LAN storefront addresses.
# Override with an absolute CDN base when using cloud-hosted images.
IMAGE_BASE_URL=/static/images
# Optional LAN testing: use your reachable storefront URL for sign-in links.
# LOCAL_FRONTEND_URL=http://YOUR_LAN_IP:8080
# LOCAL_PUBLIC_API_URL=http://YOUR_LAN_IP:8080
# Additional exact trusted origins; never use a wildcard for cookie sessions.
LOCAL_ADDITIONAL_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
VITE_API_BASE_URL=
VITE_LAUNCH_MODE=
# Real social OAuth public client credentials. Register http://localhost:8080
# in Google Cloud and Meta for Developers for local sign-in.
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=

# Cloudflare Pages production variable
# VITE_API_BASE_URL=https://api.sulocraft.com/api/v1
# VITE_LAUNCH_MODE=coming-soon
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# VITE_FACEBOOK_APP_ID=your-facebook-app-id

# Build-time public SEO API; required for full storefront builds (no credentials).
SEO_API_BASE_URL=

# Root SEO resources: production must explicitly set true or false.
# Nonproduction must be false; pages receive an HTTP noindex header.
SEO_INDEXING_ENABLED=false
# Required HTTPS storefront origin when production indexing is enabled.
SEO_PUBLIC_ORIGIN=
SEO_SITEMAP_MAX_URLS=50000
SEO_SITEMAP_MAX_BYTES=52428800
SEO_RESOURCE_CACHE_SECONDS=300

# Public API reachable by the Worker (separate from internal build API URL).
# Defaults to VITE_API_BASE_URL when configured. Never include credentials.
SEO_EDGE_API_BASE_URL=

# Public catalogue price slider bounds (whole rupees, no secrets).
VITE_CATALOGUE_PRICE_MIN=0
VITE_CATALOGUE_PRICE_MAX=100000
