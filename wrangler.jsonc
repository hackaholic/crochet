{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sulocraft",
  "main": "worker/storefront.mjs",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  },
  "env": {
    "dev": {
      "name": "sulocraft-dev"
    }
  }
}
