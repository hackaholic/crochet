# =============================================================================
# Sulocraft Production & Staging Environment Configuration Template
# Copy to .env and configure real credentials. Never commit .env into Git.
# =============================================================================

# Application Environment (development, staging, production)
APP_ENV=
PROJECT_NAME=

# Domains & Endpoints
FRONTEND_URL=
ADDITIONAL_CORS_ORIGINS=
PUBLIC_API_URL=
API_DOMAIN=

# PostgreSQL Database (Host or Docker service)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# Cross-Subdomain Authentication Cookies
COOKIE_DOMAIN=
COOKIE_SECURE=

# Cloudflare R2 Object Storage
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BACKUP_BUCKET=
R2_PUBLIC_BASE_URL=
# Public origin used when serializing stored image object keys.
# Local example: http://localhost:8000/static/images
IMAGE_BASE_URL=

# External Authentication & Social Logins
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# SMS Notifications (mock, fast2sms, twilio)
SMS_PROVIDER=
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Email Notifications (production: resend; local/test: mock)
EMAIL_PROVIDER=
EMAIL_FROM_WELCOME=
EMAIL_FROM_ORDERS=
EMAIL_FROM_SUPPORT=
EMAIL_FROM_HELLO=
# Temporary compatibility fallback while notification calls migrate.
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=
RESEND_API_KEY=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_PROVIDER=
