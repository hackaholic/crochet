# =============================================================================
# Sulocraft Production & Staging Environment Configuration Template
# Copy to .env and configure real credentials. Never commit .env into Git.
# =============================================================================

# Application Environment (development, staging, production)
APP_ENV=production
PROJECT_NAME=Sulocraft

# Domains & Endpoints
FRONTEND_URL=https://sulocraft.com
ADDITIONAL_CORS_ORIGINS=https://www.sulocraft.com,http://localhost:3000,http://localhost:8080
PUBLIC_API_URL=https://api.sulocraft.com

# PostgreSQL Database (Host or Docker service)
POSTGRES_USER=sulocraft
POSTGRES_PASSWORD=sulocraft_secure_pw
POSTGRES_DB=sulocraft
DATABASE_URL=postgresql://sulocraft:sulocraft_secure_pw@postgres:5432/sulocraft

# Cross-Subdomain Authentication Cookies
COOKIE_DOMAIN=.sulocraft.com
COOKIE_SECURE=true

# Cloudflare R2 Object Storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_PUBLIC_BUCKET=sulocraft-products
R2_PRIVATE_BACKUP_BUCKET=sulocraft-backups
R2_PUBLIC_BASE_URL=https://images.sulocraft.com

# External Authentication & SMS OTP
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SMS Notifications (mock, fast2sms, twilio)
SMS_PROVIDER=mock
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Email Notifications (mock, smtp, resend)
EMAIL_PROVIDER=mock
EMAIL_FROM=Sulocraft <orders@sulocraft.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
RESEND_API_KEY=

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
