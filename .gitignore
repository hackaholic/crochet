# Keep decryption keys and plaintext secret material out of Git.
/secrets/*
!/secrets/README.md
!/secrets/*.sops.yaml
!/secrets/encrypted/
/secrets/encrypted/*
!/secrets/encrypted/*.enc.env
**/age/keys.txt
*.agekey

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.db
.pytest_cache/
